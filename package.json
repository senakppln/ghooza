{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "nest build",
    "prev": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --logHeapUsage --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "build:packages": "pnpm build",
    "dev:prepare": "pnpm build:packages"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.6.0",
    "cookie-parser": "^1.4.7",
    "ms": "^2.1.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "4.12.0",
    "@nestjs/cli": "11.0.6",
    "@nestjs/schematics": "11.0.5",
    "@nestjs/testing": "11.0.20",
    "@swc/cli": "0.6.0",
    "@swc/core": "1.11.21",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.14.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "9.25.1",
    "prisma": "6.6.0",
    "supertest": "7.1.0",
    "typescript": "5.8.3"
  }
}
