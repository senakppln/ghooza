{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    ":semanticCommitTypeAll(chore)",
    ":widenPeerDependencies",
    ":approveMajorUpdates"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "groupName": "nestjs packages",
      "matchDepTypes": [
        "dependencies",
        "devDependencies"
      ],
      "matchPackageNames": [
        "/^@nestjs//"
      ]
    },
    {
      "groupName": "DefinitelyTyped packages",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchPackageNames": [
        "/^@types//"
      ]
    }
  ],
  "npm": {
    "commitMessageTopic": "{{prettyDepType}} {{depName}}"
  },
  "ignoreDeps": [
    "node"
  ]
}
